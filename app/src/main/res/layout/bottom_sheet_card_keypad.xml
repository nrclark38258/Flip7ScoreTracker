<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/playerNameHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/totalDisplayText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keypad_manual_label"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/manualScoreInput"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/keypad_manual_hint"
                    android:inputType="number"
                    android:textAlignment="center"
                    android:textSize="18sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/flip7BonusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/keypad_flip7_bonus"
            android:textColor="@color/green_500"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/keypad_number_cards_label"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="5">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum0"
                style="@style/CardKeypadButton"
                android:text="0" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum1"
                style="@style/CardKeypadButton"
                android:text="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum2"
                style="@style/CardKeypadButton"
                android:text="2" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum3"
                style="@style/CardKeypadButton"
                android:text="3" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum4"
                style="@style/CardKeypadButton"
                android:text="4" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum5"
                style="@style/CardKeypadButton"
                android:text="5" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum6"
                style="@style/CardKeypadButton"
                android:text="6" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum7"
                style="@style/CardKeypadButton"
                android:text="7" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum8"
                style="@style/CardKeypadButton"
                android:text="8" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum9"
                style="@style/CardKeypadButton"
                android:text="9" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum10"
                style="@style/CardKeypadButton"
                android:text="10" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum11"
                style="@style/CardKeypadButton"
                android:text="11" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cardNum12"
                style="@style/CardKeypadButton"
                android:text="12" />

        </GridLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/keypad_modifier_cards_label"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:columnCount="5">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modPlus2"
                style="@style/CardKeypadButton"
                android:text="+2" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/modPlus4"
                style="@style/CardKeypadButton"
                android:text="+4" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/modPlus6"
                style="@style/CardKeypadButton"
                android:text="+6" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/modPlus8"
                style="@style/CardKeypadButton"
                android:text="+8" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/modPlus10"
                style="@style/CardKeypadButton"
                android:text="+10" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/modX2"
                style="@style/CardKeypadButton"
                android:text="x2" />

        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/clearButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/keypad_clear"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/doneButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/keypad_done" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
