# Auto detect text files and perform LF normalization
* text=auto

# Gradle files
*.gradle text eol=lf
*.kts text eol=lf
gradlew text eol=lf
*.properties text eol=lf

# Source code
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf

# Documentation
*.md text eol=lf

# Scripts
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.so binary
*.apk binary
*.aab binary
